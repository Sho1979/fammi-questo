# ============================================================
# Fammi Questo — Configurazione Keystore per build release
# ============================================================
# 1. Copia questo file come "keystore.properties" (senza .example)
# 2. Genera la keystore con:
#    keytool -genkey -v -keystore fammi-questo-release.keystore \
#      -alias fammi-questo -keyalg RSA -keysize 2048 -validity 10000
# 3. Compila i valori sotto
# 4. NON committare keystore.properties né il file .keystore
# ============================================================

storeFile=../fammi-questo-release.keystore
storePassword=LA_TUA_PASSWORD
keyAlias=fammi-questo
keyPassword=LA_TUA_PASSWORD
