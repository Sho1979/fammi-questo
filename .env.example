# Fammi Questo — variabili d'ambiente
# Copia in .env e compila quando necessario.

# ─── Supabase (R3 — sync cloud) ──────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── Anthropic (brain-parse edge function) ────────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Cloudflare Turnstile (R4 — anti-abuse CAPTCHA) ──────────────
# Opzionale: se non impostato, l'auth anonimo funziona senza CAPTCHA.
# 1. Crea un widget Turnstile su dash.cloudflare.com → Turnstile
# 2. Scegli "Invisible" come tipo
# 3. Copia Site Key qui, Secret Key va in Supabase Dashboard → Auth → Bot Detection
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
